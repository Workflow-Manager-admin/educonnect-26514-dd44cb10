{
  "task_description": "{'component_name': 'Main Container for EduConnect', 'description': 'Primary container for EduConnect implementation: Classroom Insider is a collaborative platform for students and teachers to join, create, and manage virtual classrooms. Users can join classrooms using a code, interact via chat, bulletin board, and notebook, and access various classroom services.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Join Classroom",\n      "description": "Allows users to join a classroom by entering their name and a classroom code.",\n      "isEnabled": true\n    },\n    {\n      "name": "Unique User ID",\n      "description": "Each user is assigned a unique identifier for tracking and personalization.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dashboard",\n      "description": "Displays all classrooms the user is part of, with options to create or join new classrooms.",\n      "isEnabled": true\n    },\n    {\n      "name": "Classroom Chatbox",\n      "description": "Enables real-time messaging within each classroom.",\n      "isEnabled": true\n    },\n    {\n      "name": "Bulletin Board",\n      "description": "A space for important announcements and posts within each classroom.",\n      "isEnabled": true\n    },\n    {\n      "name": "Notebook",\n      "description": "Personal or shared notes section for each classroom.",\n      "isEnabled": true\n    },\n    {\n      "name": "Services Menu",\n      "description": "Provides access to leave classroom, group project management, and calls within each classroom.",\n      "isEnabled": true\n    },\n    {\n      "name": "Leave Classroom",\n      "description": "Option to exit a classroom from the services menu.",\n      "isEnabled": true\n    },\n    {\n      "name": "Group Project",\n      "description": "Tool for managing group projects within a classroom.",\n      "isEnabled": true\n    },\n    {\n      "name": "Calls",\n      "description": "Enables voice or video calls within a classroom.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "Python"\n    ]\n  },\n  "colors": {\n    "primary": "#addce6",\n    "secondary": "#b4fdd0",\n    "accent": "#FFD166"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a modern, clean dashboard with a sidebar listing all joined classrooms and prominent buttons to create or join a classroom. Inside a classroom, a tabbed interface provides access to Chatbox, Bulletin Board, Notebook, and Services. The Services tab opens a menu with options like Leave Classroom, Group Project, and Calls. The design uses clear navigation, intuitive icons, and responsive layouts for both desktop and mobile."\n}'}",
